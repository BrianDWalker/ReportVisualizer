<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.brianwalker.dbeaver</groupId>
    <artifactId>results-visualizer-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DBeaver Results Visualizer</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <tycho.version>5.0.3</tycho.version>
    </properties>

    <modules>
        <module>plugins/com.brianwalker.dbeaver.resultsvisualizer</module>
        <module>tests/com.brianwalker.dbeaver.resultsvisualizer.tests</module>
        <module>features/com.brianwalker.dbeaver.resultsvisualizer.feature</module>
        <module>releng/com.brianwalker.dbeaver.resultsvisualizer.repository</module>
    </modules>

    <repositories>
        <repository>
            <id>dbeaver-ce</id>
            <layout>p2</layout>
            <url>https://dbeaver.io/update/ce/latest/</url>
        </repository>
        <repository>
            <id>eclipse-2026-06</id>
            <layout>p2</layout>
            <url>https://download.eclipse.org/releases/2026-06/</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <executionEnvironment>JavaSE-21</executionEnvironment>
                    <environments>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>aarch64</arch>
                        </environment>
                        <environment>
                            <os>macosx</os>
                            <ws>cocoa</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
